{
  "name": "sanfun",
  "private": true,
  "version": "1.0.0",
  "description": "Sanfun Arcade Master Workspace",
  "scripts": {
    "dev": "npm run dev:react",
    "dev:react": "npm run --prefix frontend-react dev",
    "dev:frontend": "npm run --prefix frontend dev",
    "dev:backend": "cd backend && .\\venv\\Scripts\\python -m uvicorn app.main:app --reload",
    "dev:spring": "cd backend-spring && .\\mvnw.cmd spring-boot:run",
    "build": "npm run build:react",
    "build:react": "npm run --prefix frontend-react build",
    "test:spring": "cd backend-spring && .\\mvnw.cmd test",
    "build:spring": "cd backend-spring && .\\mvnw.cmd package -DskipTests",
    "install:all": "npm install --prefix frontend-react && npm install --prefix frontend"
  }
}
